{
  "name": "steplayer-tizen",
  "private": true,
  "version": "1.0.0",
  "description": "StePlayer for Samsung (Tizen) and LG (webOS) TVs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:webos": "node scripts/build.mjs --webos",
    "build:webos720": "node scripts/build.mjs --webos --r720",
    "package:webos": "node scripts/build.mjs --webos && node scripts/build.mjs --webos --r720 && ares-package build-webos -o dist/webos-uhd --no-minify && ares-package build-webos-720 -o dist/webos-fhd --no-minify",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "node dev/server.mjs"
  },
  "devDependencies": {
    "@material-design-icons/svg": "^0.14.15",
    "@types/node": "^24.19.2",
    "@types/pako": "^2.0.4",
    "@webos-tools/cli": "^3.2.6",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.8",
    "puppeteer-core": "^24.43.1",
    "typescript": "5.9"
  },
  "dependencies": {
    "pako": "^2.2.0"
  }
}
