<?xml version="1.0" encoding="utf-8"?>
<!-- Many streaming servers only speak plain HTTP; the user supplies the server, so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
